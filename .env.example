# Copy to `.env` and edit. Every key below maps to a field of
# `Settings` in src/smart_proxy/config.py -- except the three marked
# "process env only" at the bottom, which are read via os.environ and are
# therefore NOT picked up from this file (use systemd `EnvironmentFile=`,
# or `export` them in the shell that starts the proxy).

# Database (preferred: PostgreSQL via DATABASE_URL)
# DATABASE_URL=postgresql://user:pass@localhost:5432/smart_proxy
# Legacy / fallback SQLite path. Used when DATABASE_URL is empty.
# The SQLite schema is created on connect -- no migration step locally.
DB_PATH=./smart-proxy.db

# Logging
LOG_LEVEL=INFO

# Anthropic proxy
# Set to true to make OAuth upstream requests look like Claude CLI traffic.
CLAUDE_LIKE=false
# Set to true to strip context-1m-* beta flags from inbound Claude Code requests.
ANTHROPIC_PROXY_DISABLE_1M_CONTEXT=false
# Claude Code version claimed for clients that send no billing block of their own
# (SDKs, the OpenAI-compat endpoint, smoke checks). Anthropic gates newer models
# on it: too old and those models fail with claude_code_version_too_old while
# every other model keeps working. This is a floor — real Claude Code traffic
# through the proxy teaches it newer versions automatically. Bump it only if you
# have no CLI traffic to learn from: `npm view @anthropic-ai/claude-code version`.
ANTHROPIC_PROXY_CLAUDE_CODE_VERSION=2.1.260
# Set to false to pin to the floor above and ignore anything learned from traffic.
ANTHROPIC_PROXY_CLAUDE_CODE_VERSION_AUTOLEARN=true
# Optional: remove this exact substring from inbound `system[].text` blocks on /v1/messages.
# Leave empty to disable.
ANTHROPIC_PROXY_STRIP_SYSTEM_PHRASE=
# Upgrade Claude Code CLI's 5-minute prompt-cache breakpoints to a 1-hour TTL
# (only for requests whose original User-Agent is claude-cli/*). Default true.
ANTHROPIC_PROXY_UPGRADE_CACHE_TTL=true
# Max seconds the SSE pre-commit buffer holds the stream head before flushing and
# streaming live (forwards Anthropic keep-alive pings so a Cloudflare edge doesn't
# 524 on long-thinking responses). <=0 disables the bound. Default 10.
ANTHROPIC_PROXY_PRECOMMIT_TIMEOUT_SECONDS=10
# On SIGTERM the proxy stops accepting connections and waits this long for the
# requests already running. A single upstream turn can last 600 s, so the 60 s
# aiohttp default would cut long Claude Code turns in half on every deploy.
# systemd's TimeoutStopSec MUST be larger than this, or SIGKILL lands first.
ANTHROPIC_PROXY_SHUTDOWN_TIMEOUT_SECONDS=180

# Timezone whose midnight starts the per-key 24h spend-limit window (see /_app/#keys).
# Set to UTC to align the window with the usage dashboard's UTC days.
ANTHROPIC_PROXY_LIMIT_WINDOW_TZ=Europe/Paris
# Optional sp-* appended to POST /_reload from the CLI after key changes, for when
# proxy auth is enforced. Leave empty if /_reload is unauthenticated.
ANTHROPIC_PROXY_RELOAD_KEY=
# Operator password for the /_app/ dashboard. A caller's sp-* key signs in
# read-only; every change -- attaching or deleting an Anthropic account, editing
# roles or spend limits -- requires this. Empty means nobody can change anything.
# At least 16 characters and not an sp-/sk-ant- key, or the proxy refuses to start.
ANTHROPIC_PROXY_DASHBOARD_SECRET=

# OAuth smoke checks
# Set to false to disable the built-in daily OAuth smoke windows.
ANTHROPIC_OAUTH_SMOKE_ENABLED=true
# Local windows (ANTHROPIC_PROXY_LIMIT_WINDOW_TZ) for one random OAuth smoke
# trigger per window. Format: HH:MM-HH:MM, inclusive start and exclusive end.
ANTHROPIC_OAUTH_SMOKE_MORNING_WINDOW=08:00-09:00
ANTHROPIC_OAUTH_SMOKE_MIDDAY_WINDOW=14:00-15:00

# Standby keep-warm: refresh a standby key this many minutes before its access
# token expires, so a failover promotes an already-valid key instead of doing a
# synchronous (itself-fallible) refresh. Independent of primary state/cooldowns.
ANTHROPIC_STANDBY_KEEPWARM_ENABLED=true
ANTHROPIC_STANDBY_KEEPWARM_BUFFER_MINUTES=120

# Quota endpoint
# Require an sp-* proxy key for GET /_oauth_usage and /_oauth_usage_history.
# Default true: those endpoints report account ids and quota state for every
# OAuth row, and the proxy binds 0.0.0.0. Set to false only on a trusted LAN.
ANTHROPIC_OAUTH_USAGE_REQUIRE_AUTH=true
# Cache full /_oauth_usage JSON for this many seconds (0 = disabled). Default 60.
ANTHROPIC_OAUTH_USAGE_CACHE_SECONDS=60

# OAuth redirect (dashboard Anthropic tab, and the anthropic-login CLI)
# Public URL of this proxy. Only used to derive the redirect port below when
# that is not set explicitly; the login flows themselves do not need it.
ANTHROPIC_OAUTH_LOGIN_BASE_URL=
# The redirect_uri sent to Anthropic is http://localhost:<port>/callback. Port is
# taken from this value if numeric, else parsed from ANTHROPIC_OAUTH_LOGIN_BASE_URL,
# else ANTHROPIC_PROXY_PORT.
ANTHROPIC_OAUTH_LOGIN_REDIRECT_PORT=
# Full redirect_uri override (rare). Must match Anthropic's whitelist, which in
# practice means a localhost /callback URL.
ANTHROPIC_OAUTH_LOGIN_REDIRECT_URI=

# OpenAI-compatible endpoint (POST /v1/chat/completions on this proxy)
ANTHROPIC_PROXY_OPENAI_COMPAT_ENABLED=true
# max_tokens for translated requests that do not carry one.
ANTHROPIC_PROXY_OPENAI_COMPAT_DEFAULT_MAX_TOKENS=8192
# Inject cache_control breakpoints (system + last message) into translated
# requests; the OpenAI protocol has no prompt caching of its own.
ANTHROPIC_PROXY_OPENAI_COMPAT_AUTO_CACHE=true
# TTL for those injected breakpoints: "1h" (default; interactive agents pause
# longer than 5m) or "5m" (cheaper cache writes).
ANTHROPIC_PROXY_OPENAI_COMPAT_CACHE_TTL=1h

# Telegram operational alerts. BOTH must be set or alerting is a silent no-op --
# no key-brick warnings, and no report when the proxy itself starts failing.
# The proxy logs "Telegram alerts DISABLED" at startup when they are missing,
# and sends one "proxy started" message when they are present, which is the
# cheapest end-to-end proof that the pipe works.
ANTHROPIC_TELEGRAM_BOT_TOKEN=
ANTHROPIC_TELEGRAM_CHAT_ID=

# --- process env only (NOT read from this file; see the header) ---
# Port the proxy binds. Default 8090.
# ANTHROPIC_PROXY_PORT=8090
# Upstream Anthropic API base. Override to point at a mock or a debug proxy.
# ANTHROPIC_PROXY_UPSTREAM=https://api.anthropic.com
# OAuth token endpoint used for refresh.
# ANTHROPIC_OAUTH_TOKEN_URL=https://platform.claude.com/v1/oauth/token
